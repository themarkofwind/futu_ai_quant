# 复制后填入真实值：
#   cp .env.example .env
#
# 约定：未写出的项都有代码默认值，一般不用改。
# 密钥类只放本文件复制出的 .env，不要提交 git。

# ==================== 必填 / 常用 ====================

# --- LLM（持仓分析 / 自选分析默认 DeepSeek）---
# 作用：调用大模型生成结构化建议；不用 AI 时可只跑 --no-ai，可不配 Key
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_PROVIDER=deepseek          # deepseek | openai | anthropic | gemini | custom
# LLM_MODEL=deepseek-v4-flash    # 留空=提供商默认模型

# --- Futu OpenD ---
# 作用：连接本地/本机行情与交易网关
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
# FUTU_TRADE_UNLOCK_PWD=          # 实盘解锁交易密码；仅查询行情/模拟可不填

# --- PushPlus（微信推送）---
# 作用：futu-analyze 持仓摘要一对一；futu-watchlist 自选摘要（可进群）
# 官网注册：https://www.pushplus.plus/
PUSHPLUS_ENABLED=1
PUSHPLUS_TOKEN=your_pushplus_token
PUSHPLUS_TOPIC=                   # 群组编码；仅自选分析使用。持仓分析强制一对一，忽略此项
# PUSHPLUS_TEMPLATE=txt           # html | txt | markdown

# --- 自选股 futu-watchlist ---
# 作用：三槽定时分析（默认 09:00 / 13:05 / 15:30），非交易日按 OpenD 日历跳过
# 标的优先读 JSON 文件（可热改），否则用下面逗号列表
# 示例：cp watchlist_codes.example.json data/watchlist/codes.json
# WATCHLIST_CODES_FILE=data/watchlist/codes.json
# WATCHLIST_CODES=HK.01347,HK.00700,HK.09988,HK.06869
# WATCHLIST_SLOT_AUCTION=09:00    # 盘前竞价
# WATCHLIST_SLOT_LUNCH=13:05      # 午后开盘
# WATCHLIST_SLOT_PRECLOSE=15:30   # 收盘前半小时

# --- 日内做 T（futu-intraday-t / watch / pair）+ Bark ---
# 作用：连续交易时段（OpenD market_state=MORNING/AFTERNOON）内信号推 iPhone
# 默认：华虹实时监控；阿里+腾讯轮询。改本段多数项约 2 秒热加载（换实时标的需重启 t/pair）
INTRADAY_T_CODE=HK.01347
INTRADAY_T_CODES=HK.09988,HK.00700
# INTRADAY_T_POLL_SEC=60          # 多标的轮询间隔（秒）
# INTRADAY_T_LOT_PCT=30           # 按持仓比例折算整手；0=用固定股数
# INTRADAY_T_LOT_SIZE=1000        # 无持仓或 LOT_PCT=0 时的固定股数
# INTRADAY_T_TARGET_SPREAD=1.2    # 目标净价差下限（港币/股等）
# INTRADAY_T_RSI_SELL=75          # 高抛 RSI 阈值
# INTRADAY_T_RSI_BUY=35           # 低吸 RSI 阈值

BARK_ENABLED=1
BARK_DEVICE_KEY=your_bark_device_key   # 只填 key；App 地址形如 https://api.day.app/<key>/...
# BARK_SERVER=https://api.day.app
# BARK_GROUP=日内做T
# BARK_LEVEL=timeSensitive
# BARK_NOTIFY_WARNING=0           # 1=强趋势 WARNING 也推 Bark

# ==================== 可选调优 ====================

# --- 持仓分析 futu-analyze 轮询间隔 ---
# ANALYSIS_INTERVAL_SEC=0         # 0=自动（盘中约 30 分钟，盘外约 4 小时）；>0=固定秒数
# INTRADAY_INTERVAL_SEC=1800
# OFFHOURS_INTERVAL_SEC=14400

# --- 本地模拟 futu-sim ---
# SIM_INITIAL_CASH=1000000
# SIM_COMMISSION_RATE=0.0003
# SIM_MIN_COMMISSION=3
# SIM_PLATFORM_FEE=15
# SIM_STAMP_DUTY_RATE=0.0013

# --- 换 LLM 提供商时再配 ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
